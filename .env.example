# Local secrets — never commit
DEAFRICA_SANDBOX_API_KEY=368635bded97413c82f9afce36206986

# Cross-origin callers for /api/* (comma-separated). Leave unset for same-origin use:
# the bundled sandbox at / fetches /api/* with relative URLs and needs no entry here.
# A wildcard is not supported — credentialed CORS requires explicit origins.
# ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# Hostnames the MCP SSE transport may be reached on (comma-separated). Setting any value
# enables DNS-rebinding protection; leaving it blank leaves it off, which is what a
# reverse proxy or Render's hop needs unless you know the real host.
# ALLOWED_HOSTS=sitesurveyor.example.com
